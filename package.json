{
  "name": "decky-eden-settings",
  "version": "1.0.0",
  "description": "Change Eden (Nintendo Switch emulator) settings globally or per game from Steam Game Mode, with an explanation for every option",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -I -m unittest discover -s tests -v"
  },
  "keywords": [
    "decky",
    "plugin",
    "eden",
    "switch",
    "emulation",
    "steam-deck",
    "bazzite"
  ],
  "author": "Lucas M.",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/simkin/decky-eden-settings.git"
  },
  "homepage": "https://github.com/simkin/decky-eden-settings",
  "bugs": {
    "url": "https://github.com/simkin/decky-eden-settings/issues"
  }
}
